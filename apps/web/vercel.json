{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@portraq/web",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/fetch-kr-closing-prices",
      "schedule": "30 9 * * 1-5"
    },
    {
      "path": "/api/cron/fetch-us-closing-prices",
      "schedule": "30 21 * * 1-5"
    },
    {
      "path": "/api/cron/fetch-kr-stock-dividends",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/fetch-kodex-etf-dividends",
      "schedule": "10 22 * * *"
    },
    {
      "path": "/api/cron/fetch-tiger-etf-dividends",
      "schedule": "20 22 * * *"
    },
    {
      "path": "/api/cron/fetch-plus-etf-dividends",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/fetch-sol-etf-dividends",
      "schedule": "40 22 * * *"
    }
  ]
}
