{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@portraq/web",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/fetch-kr-closing-prices",
      "schedule": "30 9 * * 1-5"
    },
    {
      "path": "/api/cron/fetch-us-closing-prices",
      "schedule": "30 21 * * 1-5"
    }
  ]
}
